/**
 * @ Version: SCREEN SPACE SHADERS - UPDATE 21
 * @ Description: AO implementation (GTAO Enabled)
 * @ Modified time: 2025-05-20 04:53:43
 * @ Author: https://www.moddb.com/members/ascii1457
 * @ Mod: https://www.moddb.com/mods/stalker-anomaly/addons/screen-space-shaders
 *
 * Updated by Lvutner and Hippobot (Atmospherics 2.69 base).
 *
 * scaled-AO engine pair (xray-monolith fork): under SSFX_AO_SCALED_BLUR the temporal
 * reprojection runs in the full-screen UV domain (like ssfx_il.ps) so AO history
 * reprojects correctly at reduced resolution. Identical at scale 1; stock without the define.
 *
 * Metal/DXMT hardening: reject degenerate GTAO geometry and temporal history
 * before zero-length rsqrt or projective/depth division can generate NaN/Inf.
 */
#ifndef SSFX_READY
    #include "screenspace_common.h"
#endif

#include "settings_screenspace_AO.h"

// Internal values
uniform float4 ao_setup;
// Res, Intensity, -, Radius
uniform float4 ssfx_ao_setup2; // Distance, HUD, Flora, MaxOcc

float4x4 m_current; // Current projection matrix
float4x4 m_previous; // Previous projection matrix

Texture2D ssfx_ao;
Texture2D s_motion_vectors;
Texture2D s_prev_pos;
Texture2D jitter0;

sampler smp_jitter;

//Constants
float4 ogse_c_screen;

// [elseform] Metal/DXMT hardening: finite-value helpers used below to reject
// NaN/Inf before rsqrt, division, and temporal-history blending.
static const float D3DM_GTAO_EPSILON = 1e-6f;
static const float D3DM_GTAO_MAX_FINITE = 1e30f;

bool d3dm_gtao_valid_positive(float value)
{
    // Both comparisons are false for NaN; the upper bound also rejects infinity.
    return value > D3DM_GTAO_EPSILON && value < D3DM_GTAO_MAX_FINITE;
}

bool d3dm_gtao_valid_float4(float4 value)
{
    return all(value == value) && all(abs(value) < D3DM_GTAO_MAX_FINITE);
}

float d3dm_gtao_finite_or(float value, float fallback)
{
    return value == value && abs(value) < D3DM_GTAO_MAX_FINITE ? value : fallback;
}

float calc_GTAO(float3 view_position, float3 view_normal, float2 texcoord, float2 jitter)
{
    const float GTAO_TAU = 6.2831854;
    const float GTAO_HALF_PI = 1.5707964;

    int GTAO_DIRECTIONS = SSFX_AO_QUALITY / 2;
    int GTAO_STEPS = SSFX_AO_QUALITY;
    float GTAO_RADIUS = ao_setup.w;

    float view_position_length_sq = dot(view_position, view_position);
    float view_normal_length_sq = dot(view_normal, view_normal);

    // [elseform] Reject degenerate radius/geometry before the rsqrt below.
    if (!d3dm_gtao_valid_positive(GTAO_RADIUS) ||
        !d3dm_gtao_valid_positive(view_position_length_sq) ||
        !d3dm_gtao_valid_positive(view_normal_length_sq) ||
        !d3dm_gtao_valid_positive(view_position.z) ||
        GTAO_DIRECTIONS <= 0 || GTAO_STEPS <= 0)
        return 1.0f;

    float gtao_radius_sq = GTAO_RADIUS * GTAO_RADIUS;
    // [elseform] Guard the falloff denominator (GTAO_NEG_1_OVER_RADIUSQR) below.
    if (!d3dm_gtao_valid_positive(gtao_radius_sq))
        return 1.0f;

    float GTAO_NEG_1_OVER_RADIUSQR = -1.0f / gtao_radius_sq;

    float3 view_direction = -view_position * rsqrt(view_position_length_sq);
    view_position *= 0.9992f;

    float projection_divisor = ogse_c_screen.z * 2.0f;
    // [elseform] Guard projection-scale division.
    if (!d3dm_gtao_valid_positive(projection_divisor))
        return 1.0f;

    float gtao_parameters = screen_res.y / projection_divisor; //projection scale
    gtao_parameters *= 0.5;

    float screen_radius = (GTAO_RADIUS * gtao_parameters) / view_position.z;
    // [elseform] Reject NaN/Inf screen_radius before it scales slice_scale.
    if (!(screen_radius == screen_radius) || abs(screen_radius) >= D3DM_GTAO_MAX_FINITE)
        return 1.0f;

    float2 slice_scale = screen_radius * float2(screen_res.z, -screen_res.w);
    float slice_angle = GTAO_TAU / float(GTAO_DIRECTIONS);

    float2 occ_weight = (0.0).xx;

    for (int i = 0; i < GTAO_DIRECTIONS; i++)
    {
        float angle = (float(i) + jitter.x) * slice_angle;
        float3 slice_direction = float3(cos(angle), sin(angle), 0.0);

        float3 ortho_direction = slice_direction - view_direction * dot(slice_direction.xy, view_direction.xy);
        float3 axis = cross(slice_direction, view_direction);

        float3 proj_normal = view_normal - axis * dot(view_normal, axis);
        float proj_normal_length_sq = dot(proj_normal, proj_normal);
        // [elseform] Skip a zero-length projected normal instead of feeding
        // it into sqrt/rcp below.
        if (!d3dm_gtao_valid_positive(proj_normal_length_sq))
            continue;

        float proj_normal_length = sqrt(proj_normal_length_sq);
        proj_normal *= rcp(proj_normal_length);

        float sin_n = dot(ortho_direction, -proj_normal);

        float max_horizon_cos = sin_n;

        for(int j = 0; j < GTAO_STEPS; j++)
        {
            float increment = (float(j) + jitter.y) / GTAO_STEPS;
            increment *= increment;

            float2 s_texcoord = texcoord.xy + slice_direction.xy * slice_scale.xy * increment;

            if(dot(s_texcoord - saturate(s_texcoord), 1.0) != 0.0)
                break;

            #ifndef USE_MSAA
                float3 gbuffer_data = s_position.Load(int3(s_texcoord * screen_res.xy, 0)).xyz;
            #else
                float3 gbuffer_data = s_position.Load(int3(s_texcoord * screen_res.xy, 0), 0).xyz;
            #endif

            float3 vs = gbuffer_data.z * float3((s_texcoord * screen_res.xy) * pos_decompression_params.zw - pos_decompression_params.xy, 1.0);
            float3 s_vector = vs - view_position;

            float s_vec_length = dot(s_vector, s_vector);
            // [elseform] Skip a coincident sample instead of feeding a
            // zero-length vector into rsqrt below.
            if (!d3dm_gtao_valid_positive(s_vec_length))
                continue;

            float s_horizon = dot(s_vector, view_direction) * rsqrt(s_vec_length);
            float falloff = saturate(s_vec_length * GTAO_NEG_1_OVER_RADIUSQR + 1.0);

            s_horizon = lerp(-1.0, s_horizon, falloff);
            max_horizon_cos = max(max_horizon_cos, s_horizon);
        }
        max_horizon_cos = saturate(0.5 * sin(GTAO_HALF_PI * (1.0 + sin_n) - GTAO_HALF_PI * max_horizon_cos) + 0.5);

        occ_weight += float2(1.0 - max_horizon_cos, 1.0) * proj_normal_length;
    }

    // [elseform] Guard occ_weight.y before the reciprocal below.
    if (!d3dm_gtao_valid_positive(occ_weight.y))
        return 1.0f;

    occ_weight.x *= rcp(occ_weight.y);
    return saturate(1.0 - occ_weight.x * 2.0);
}


float4 main(p_screen I) : SV_Target
{
    // [elseform] Fall back to unscaled AO if ao_setup.x is invalid.
    float ao_scale = d3dm_gtao_valid_positive(ao_setup.x) ? ao_setup.x : 1.0f;

    // Scale TexCoor
    float2 tc = I.tc0.xy * ao_scale;
    float2 Pos2D = I.hpos.xy * ao_scale;

    // Sample position buffer
    #ifndef USE_MSAA
        float4 Pos = s_position.Sample( smp_nofilter, tc );
    #else
        float4 Pos = s_position.Load( int3( Pos2D, 0 ), 0 );
    #endif

    // Reconstruct Position, Normal and Material
    float3 P    = float3( Pos.z * ( Pos2D * pos_decompression_params.zw - pos_decompression_params.xy ), Pos.z );
    float3 N    = gbuf_unpack_normal( Pos.xy );
    //float mtl   = gbuf_unpack_mtl( Pos.w );

    // Rendering AO till ssfx_ao_setup2.x || Sky
    // [elseform] Added the P.z >= D3DM_GTAO_MAX_FINITE branch: reject a
    // non-finite reconstructed depth before it reaches calc_GTAO.
    if (!(P.z > SKY_EPS) || P.z >= ssfx_ao_setup2.x || P.z >= D3DM_GTAO_MAX_FINITE)
        return float4(0,0,0,1);

    // Ao Noise
    float3 ao_noise = jitter0[uint2(I.hpos.xy)%64];
    ao_noise.xy = frac(ao_noise.xy + (timers.x*100.) * float2(0.245122333753, 0.430159709002));

    // MAT_FLORA from current pixel?????????
    bool mat_flora = false;//abs(mtl - MAT_FLORA) <= 0.04f;

    float4 Motion_Vectors = s_motion_vectors.Sample(smp_nofilter, tc);
    // [elseform] Sanitize each motion-vector component instead of letting a
    // corrupt sample poison HUD masking and temporal reprojection below.
    Motion_Vectors = float4(
        d3dm_gtao_finite_or(Motion_Vectors.x, 0.0f),
        d3dm_gtao_finite_or(Motion_Vectors.y, 0.0f),
        d3dm_gtao_finite_or(Motion_Vectors.z, 0.0f),
        d3dm_gtao_finite_or(Motion_Vectors.w, 0.0f));

    float WeaponFactor = Motion_Vectors.z;

    if (Motion_Vectors.w < -0.5)
        mat_flora = true;

    float HUD_Multiply = clamp(1.0 - WeaponFactor, ssfx_ao_setup2.y, 1.0f);

    // HIPPOBOT: Enabled GTAO implementation

    // Calc da high qual gtao
    float occ = calc_GTAO(P, N, tc, ao_noise.xy);

    // Apply Flora Mask
    if (mat_flora)
        occ = lerp(1.0, occ, ssfx_ao_setup2.z);

    // Apply HUD/Weapon Intensity Mask
    occ = lerp(1.0, occ, HUD_Multiply);

    // Apply Main Intensity
    float ao_intensity = ao_setup.y;
    if (!(ao_intensity >= 0.0f) || ao_intensity >= D3DM_GTAO_MAX_FINITE)
        ao_intensity = 1.0f;
    occ = ao_intensity > 0.0f ? pow(occ, ao_intensity) : 1.0f;

    // Apply Distance Fadeout
    float Fadeoff = smoothstep(ssfx_ao_setup2.x * 0.7f, ssfx_ao_setup2.x, P.z);
    occ = saturate(occ + Fadeoff);

    float4 P4 = float4(P.xyz, 1.0);

    float4 p_current = mul(m_current, P4);

    float4 p_previous = mul(m_previous, P4);

    // Reprojection UV
    float2 cam_rp = 0.0f;
    if (d3dm_gtao_valid_float4(p_current) &&
        d3dm_gtao_valid_float4(p_previous) &&
        d3dm_gtao_valid_positive(abs(p_current.w)) &&
        d3dm_gtao_valid_positive(abs(p_previous.w)))
    {
        float2 current = p_current.xy / p_current.w;
        float2 previous = p_previous.xy / p_previous.w;
        cam_rp = current.xy - previous.xy;
    }
    cam_rp = float2(cam_rp.x, -cam_rp.y) * 0.5f;

    // Velocity
    float vel = d3dm_gtao_finite_or(length(Motion_Vectors.xy) * 10.0f, 1.0f);

    // Without Camera MV
    float vel_history = d3dm_gtao_finite_or(
        length(Motion_Vectors.xy - cam_rp * (1.0f - WeaponFactor)) * 100.0f,
        1.0f);

    // HUD Mask
    if (WeaponFactor)
        vel_history *= 0.2f;

	float2 rnd = hash22(tc * 100 + timers.xx * 100) * 2.0f - 1.0f;
	// [elseform] Guard screen_res components before dividing rnd by them.
	float2 safe_screen_res = float2(
		d3dm_gtao_valid_positive(screen_res.x) ? screen_res.x : 1.0f,
		d3dm_gtao_valid_positive(screen_res.y) ? screen_res.y : 1.0f);
	rnd = rnd * (1.0f / safe_screen_res) * 0.25f;

#ifdef SSFX_AO_SCALED_BLUR
	// Reproject in full-screen UV domain (like ssfx_il.ps): rescale corner-domain I.tc0
	// before applying the motion vector / sampling full-res s_prev_pos. Identical at scale 1.
	float2 full_tc = I.tc0.xy * ao_scale;
#else
	float2 full_tc = I.tc0.xy;
#endif
	float2 Rep_Tc = (full_tc + rnd) - Motion_Vectors.xy;

	float4 prev = ssfx_ao.Sample(smp_rtlinear, clamp(Rep_Tc / ao_scale, 0.0f, float2(0.999f, 0.99f) / ao_scale));

	float4 prev_P = s_prev_pos.Sample(smp_rtlinear, Rep_Tc);
	bool valid_history = d3dm_gtao_valid_float4(prev) &&
		d3dm_gtao_valid_float4(prev_P) &&
		d3dm_gtao_valid_positive(prev_P.z);
	if (!valid_history)
	{
		// [elseform] Reject corrupt history instead of letting NaN poison current AO.
		prev = float4(0.0f, 0.0f, 1.0f, 1.0f);
		prev_P = float4(0.0f, 0.0f, P.z, 1.0f);
	}

	float outoffsrc = any(Rep_Tc < 0) + any(Rep_Tc > 1.0f);
	outoffsrc = lerp(outoffsrc, prev.g, 0.9f);
    float docc = valid_history ?
        d3dm_gtao_finite_or(abs(1.0f - P.z / prev_P.z), 1.0f) :
        1.0f;

    docc = d3dm_gtao_finite_or(docc * (1.0f + WeaponFactor), 1.0f);

    // 0 Current frame ~ 1 Prev frame
    float weight = valid_history ? saturate(0.85f - (vel + outoffsrc + docc + prev.b)) : 0.0f;

    // Mix previous frames
    occ = lerp(occ, prev.w, weight);


    // Limit AO maximum occlusion
    occ = clamp(occ, ssfx_ao_setup2.w, 1.0f);

    // Disocclusion mask
    float docc_mask = saturate(docc - 0.05f);
    docc_mask = lerp((docc + vel + outoffsrc) * 10, prev.r, 0.95f);

    return saturate(float4(docc_mask, outoffsrc, lerp(vel_history, saturate(prev.b - 0.001f), 0.92f), occ));
}
