#include "common.h"
// [elseform] SSS motion-vector helpers.
#include "screenspace_mvectors.h"

uniform float4 markswitch_color;

float2 unpack_ms_dot_offset()
{
    if (markswitch_color.a <= 0.0)
        return float2(0.0, 0.0);

    float packed = floor(saturate(markswitch_color.a) * 4198401.0 + 0.5) - 1.0;
    float x = floor(packed / 2049.0);
    float y = packed - x * 2049.0;
    return (float2(x, y) / 2048.0 * 2.0 - 1.0) * 0.01;
}

#define OFFSET 0.0039
#define PARALLAX 1000.0
#define SCALE 160.0

struct vf
{
	float4 hpos : SV_Position;
    float2 tc0 : TEXCOORD0;
    float3 P : TEXCOORD1;
	// [elseform] Match models_reflex_reticle.vs exactly.
	float3 T : TEXCOORD2;
	float3 B : TEXCOORD3;
	float3 N : TEXCOORD4;
	float4 vel_curr : TEXCOORD5;
	float4 vel_prev : TEXCOORD6;
};

// [elseform] Reticles are thin additive HUD overlays. Without their own motion vectors,
// SSS TAA / DLSS reprojected them with the motion of the world behind the glass and the
// reticle pulsed in brightness while the camera moved. Write HUD motion vectors and the
// TAA skip mask into the forward-pass motion-vector target, as pda_overlay.ps does.
struct reticle_out
{
	float4 color : SV_Target0;
	float4 velocity : SV_Target2;
};

float4 reticle_color(vf I)
{
	float3x3 TBN = float3x3(I.T + OFFSET, I.B + OFFSET, I.N);
    float3 V_tangent = normalize(float3(dot(-I.P, TBN[0]), dot(-I.P, TBN[1]), dot(-I.P, TBN[2])));
    float2 parallax_tc = I.tc0 - V_tangent.xy * PARALLAX;
	
	parallax_tc = (parallax_tc + (SCALE - 1) / 2) / SCALE;
	
    return s_base.Sample(smp_rtlinear, parallax_tc + unpack_ms_dot_offset());
}

reticle_out main(vf I)
{
	reticle_out O;
	float4 reticle = reticle_color(I);
	// [elseform] Premultiplied output for blend(one, invsrcalpha): rgb * a added onto the scene,
	// exactly the old srcalpha/one additive result.
	float3 added = reticle.rgb * reticle.a;
	O.color = float4(added, 0.0);
	// [elseform] Coverage of the visible reticle. The motion-vector target blends by this alpha,
	// so HUD motion vectors and the TAA skip mask replace the world's vectors under the reticle
	// strokes and leave the world behind the empty glass untouched.
	float coverage = smoothstep(0.02, 0.25, max(added.r, max(added.g, added.b)));
	O.velocity = ssfx_mv_calc(I.vel_curr, I.vel_prev, 1, 1) * coverage;
	return O;
}
