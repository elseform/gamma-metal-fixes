#include "common.h"

uniform float4 markswitch_color;

float2 unpack_ms_dot_offset()
{
    if (markswitch_color.a <= 0.0)
        return float2(0.0, 0.0);

    float packed = floor(saturate(markswitch_color.a) * 4198401.0 + 0.5) - 1.0;
    float x = floor(packed / 2049.0);
    float y = packed - x * 2049.0;
    return (float2(x, y) / 2048.0 * 2.0 - 1.0) * 0.01;
}
#include "mark_adjust.h"

#define OFFSET 0.0039
#define PARALLAX 1000.0
#define SCALE 160.0

struct vf
{
	float4 hpos : SV_Position;
    float2 tc0 : TEXCOORD0;
    float3 P : TEXCOORD1;
	// [elseform] Match models_reflex_reticle.vs exactly.
	float3 T : TEXCOORD2;
	float3 B : TEXCOORD3;
	float3 N : TEXCOORD4;
};

float4 main(vf I): SV_Target
{
	float3x3 TBN = float3x3(I.T + OFFSET, I.B + OFFSET, I.N);
    float3 V_tangent = normalize(float3(dot(-I.P, TBN[0]), dot(-I.P, TBN[1]), dot(-I.P, TBN[2])));
    float2 parallax_tc = I.tc0 - V_tangent.xy * PARALLAX;
	
	parallax_tc = (parallax_tc + (SCALE - 1) / 2) / SCALE;
	
	#ifdef MARK_ADJUST
	parallax_tc = mark_adjust(parallax_tc);
	#endif

    return s_base.Sample(smp_rtlinear, parallax_tc + unpack_ms_dot_offset());
}
